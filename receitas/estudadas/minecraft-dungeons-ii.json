{
  "formato": 1,
  "motor": ">=1,<2",
  "jogo": {"chave": "steam_app_1912410", "leitura_de_memoria": "nao"},
  "permissoes": [
    "ler:jogo.som",
    "ler:jogo.vibracao",
    "ler:jogo.haptica",
    "ler:jogo.gatilho",
    "ler:entradas",
    "ler:botoes"
  ],
  "entradas": {
    "lado_na_luz": {"rotulo": "Lado na luz", "tipo": "ligado", "padrao": false},
    "coracao": {"rotulo": "Coração", "tipo": "deslizante", "minimo": 0, "maximo": 100,
                "padrao": 100},
    "golpe_com_lado": {"rotulo": "Golpe com lado", "tipo": "deslizante", "minimo": 0,
                       "maximo": 100, "padrao": 70},
    "luz_do_dano": {"rotulo": "Luz do dano", "tipo": "ligado", "padrao": true},
    "cor_do_dano": {"rotulo": "Cor do dano", "tipo": "cor", "padrao": "#ff0000"},
    "susto_no_alto_falante": {"rotulo": "Susto no alto-falante", "tipo": "ligado",
                              "padrao": true},
    "susto_no_tato": {"rotulo": "Susto no tato", "tipo": "ligado", "padrao": true},
    "intervalo_do_susto": {"rotulo": "Intervalo do susto", "tipo": "deslizante", "minimo": 1,
                           "maximo": 30, "padrao": 5},
    "impacto_nos_gatilhos": {"rotulo": "Impacto nos gatilhos", "tipo": "ligado",
                             "padrao": true},
    "clima": {"rotulo": "Clima", "tipo": "deslizante", "minimo": 10, "maximo": 90,
              "padrao": 35}
  },
  "sentidos": {
    "estalo_forte": {"de": "sentido.som", "especie": "evento", "nome": "estalo_forte"},
    "estalo_esquerdo": {"de": "sentido.som", "especie": "evento", "nome": "estalo_forte",
                        "campo": "lado", "igual": "esquerdo"},
    "estalo_direito": {"de": "sentido.som", "especie": "evento", "nome": "estalo_forte",
                       "campo": "lado", "igual": "direito"},
    "batimento": {"de": "sentido.rumble", "especie": "nivel", "nome": "nivel", "campo": "tensao"},
    "dano_do_rumble": {"de": "sentido.rumble", "especie": "nivel", "nome": "nivel",
                       "campo": "dano_recente"},
    "rajada": {"de": "sentido.rumble", "especie": "evento", "nome": "rajada"},
    "golpe_no_r2": {"de": "sentido.golpe", "especie": "evento", "nome": "dado",
                    "campo": "gatilho", "igual": "r2"},
    "golpe_no_l2": {"de": "sentido.golpe", "especie": "evento", "nome": "dado",
                    "campo": "gatilho", "igual": "l2"}
  },
  "derivados": {
    "tensao": {"expr": "limita(max(batimento, dano_do_rumble * 0.6), 0, 1)"}
  },
  "estados": {
    "tenso": {"quando": "tensao > $clima / 100", "histerese": 0.1, "minimo_ms": 2000},
    "muito_tenso": {"quando": "tensao > $clima / 100 + 0.35", "histerese": 0.1, "minimo_ms": 2000}
  },
  "efeitos": {
    "coracao": {"canal": "haptica", "padrao": "coracao", "lado": "ambos",
                "forca": "0.5 * $coracao / 100", "bpm": 95},
    "coracao_acelerado": {"canal": "haptica", "padrao": "coracao", "lado": "ambos",
                          "forca": "0.75 * $coracao / 100", "bpm": 130},
    "motor_esquerdo": {"canal": "motor", "lado": "esquerdo",
                       "forca": "$golpe_com_lado / 70 * 0.6", "dura_ms": 160},
    "motor_direito": {"canal": "motor", "lado": "direito",
                      "forca": "$golpe_com_lado / 70 * 0.6", "dura_ms": 160},
    "luzes_da_esquerda": {"canal": "leds", "lado": "esquerdo", "dura_ms": 600},
    "luzes_da_direita": {"canal": "leds", "lado": "direito", "dura_ms": 600},
    "vermelho": {"canal": "luz", "cor": "$cor_do_dano", "brilho": 1.0, "dura_ms": 400},
    "susto_no_alto_falante": {"canal": "som", "som": "recorte", "volume": 1.0},
    "susto_no_tato": {"canal": "haptica", "padrao": "susto", "lado": "ambos", "forca": 1.0},
    "impacto_no_r2": {"canal": "gatilho", "modo": "vibracao", "lado": "r2", "posicao": 2,
                      "amplitude": 6, "frequencia": 40, "dura_ms": 150},
    "impacto_no_l2": {"canal": "gatilho", "modo": "vibracao", "lado": "l2", "posicao": 2,
                      "amplitude": 6, "frequencia": 40, "dura_ms": 150},
    "peso_da_mira": {"canal": "mira",
                     "ganho": "mapeia(max(tensao, dano_do_rumble), 0, 1, 1, 0.6)"}
  },
  "regras": [
    {"quando": "tenso", "entao": "coracao", "para": "todos"},
    {"quando": "muito_tenso", "entao": "coracao_acelerado", "para": "todos"},
    {"quando": "estalo_esquerdo", "entao": "motor_esquerdo", "para": "todos"},
    {"quando": "estalo_direito", "entao": "motor_direito", "para": "todos"},
    {"quando": "estalo_esquerdo e $lado_na_luz", "entao": "luzes_da_esquerda", "para": "todos"},
    {"quando": "estalo_direito e $lado_na_luz", "entao": "luzes_da_direita", "para": "todos"},
    {"quando": "rajada e $luz_do_dano", "entao": "vermelho", "para": "quem_levou"},
    {"quando": "estalo_forte e tenso e $susto_no_alto_falante", "entao": "susto_no_alto_falante",
     "prioridade": 10, "espera_ms": "$intervalo_do_susto * 1000", "para": "todos"},
    {"quando": "estalo_forte e tenso e $susto_no_tato", "entao": "susto_no_tato",
     "prioridade": 10, "espera_ms": "$intervalo_do_susto * 1000", "para": "todos"},
    {"quando": "golpe_no_r2 e $impacto_nos_gatilhos", "entao": "impacto_no_r2",
     "para": "quem_levou"},
    {"quando": "golpe_no_l2 e $impacto_nos_gatilhos", "entao": "impacto_no_l2",
     "para": "quem_levou"},
    {"quando": "tenso", "entao": "peso_da_mira", "para": "todos"}
  ]
}
